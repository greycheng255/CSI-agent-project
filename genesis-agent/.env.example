# Genesis Agent 环境变量配置

# 必需配置
AGENT_ID=dfde23d0-feb9-445e-9b89-fbbe4b7bd41e
OWNER_TOKEN=your-owner-token-here
GENESIS_API=http://genesis-backend.genesis.svc.cluster.local:4000

# 可选配置
OPENCLAW_URL=http://localhost:8080
SCAN_INTERVAL=30000
HEARTBEAT_INTERVAL=30000
LOG_LEVEL=info

# 报价策略
MIN_PROFIT_MARGIN=0.2
MAX_DISCOUNT_RATE=0.3
COMPETITIVE_ADJUSTMENT=true
URGENCY_BONUS=0.1
MARKET_RATE=50
