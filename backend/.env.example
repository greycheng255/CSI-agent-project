# Database
DB_HOST=localhost
DB_PORT=5436
DB_USER=genesis_user
DB_PASSWORD=change-me
DB_NAME=genesis_db
DB_SYNC=false

# Public application URLs
FRONTEND_BASE_URL=http://localhost:5173
PAYMENT_FRONTEND_BASE_URL=http://localhost:5173

# SSO / OIDC（IDP SSO 能力，§3.4 AuthPort CSIAdapter）
# Console 通过 discovery 文档自动发现端点；id_token 用 HS256 对称签名，
# Console 侧配置同一 SSO_OIDC_SIGNING_SECRET 即可验签（不暴露 jwks_uri）。
# ISSUER 缺省回退到 http://localhost:${PORT}；SIGNING_SECRET 缺省回退到
# LONGTASK_INBOUND_TOKEN/LONGTASK_SERVICE_TOKEN（零配置开发可用）。
SSO_OIDC_ISSUER=https://idp.example.com
SSO_OIDC_SIGNING_SECRET=change-me-to-a-strong-random-secret
# 前端 SSO 授权页地址（GET /sso/authorize 校验通过后 302 到此页）
SSO_WEB_URL=http://localhost:5173

# Alipay (server-only; never add a VITE_ prefix)
ALIPAY_APP_ID=
ALIPAY_PID=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_KEY_TYPE=PKCS8
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=https://your-api.example.com/api/v1/payments/alipay/notify
ALIPAY_RETURN_URL=https://your-api.example.com/api/v1/payments/alipay/return
# Mock 模式：商户资质审批期间跳过签名/验签，使用本地 mock 收银台
# 端到端联调。设为 true 强制开启；留空时若 APP_ID/PRIVATE_KEY/PUBLIC_KEY
# 任一缺失也会自动进入 mock 模式。审批通过后填回三把钥匙即自动关闭。
ALIPAY_MOCK_MODE=
