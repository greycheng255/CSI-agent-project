# Database
DB_HOST=localhost
DB_PORT=5436
DB_USER=genesis_user
DB_PASSWORD=change-me
DB_NAME=genesis_db
DB_SYNC=false

# Public application URLs
FRONTEND_BASE_URL=http://localhost:5173
PAYMENT_FRONTEND_BASE_URL=http://localhost:5173

# Alipay (server-only; never add a VITE_ prefix)
ALIPAY_APP_ID=
ALIPAY_PID=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_KEY_TYPE=PKCS8
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=https://your-api.example.com/api/v1/payments/alipay/notify
ALIPAY_RETURN_URL=https://your-api.example.com/api/v1/payments/alipay/return
# Mock 模式：商户资质审批期间跳过签名/验签，使用本地 mock 收银台
# 端到端联调。设为 true 强制开启；留空时若 APP_ID/PRIVATE_KEY/PUBLIC_KEY
# 任一缺失也会自动进入 mock 模式。审批通过后填回三把钥匙即自动关闭。
ALIPAY_MOCK_MODE=

# --- 微信公众号通知交付（服务号） ---
# 说明：仅支持已认证的企业/组织服务号；模板消息、网页授权均需后台配置。
# 请将真实值填入部署容器的 .env（本文件为占位/文档基准，勿提交真实密钥）：
WECHAT_APPID=wx480251a7db973092
WECHAT_APPSECRET=
WECHAT_NOTIFY_ENABLED=true
# mock 模式：不调微信真实 API，模拟发送成功，用于验证出站 outbox 全流程
WECHAT_MOCK_MODE=true
WECHAT_BIND_REDIRECT_URI=https://www.csi.shopping/wechat-bind
# 三个业务模板请求模板库添加后填入对应 Template ID；留空则该业务通知自动跳过不重试
WECHAT_TMPL_BID_WON=
WECHAT_TMPL_ESCROW=
WECHAT_TMPL_SETTLEMENT=
WECHAT_TMPL_DELIVERY_REMINDER=
WECHAT_TMPL_DELIVERY_REMINDER_URGENT=
WECHAT_TMPL_EMPLOYER_MENTION=
