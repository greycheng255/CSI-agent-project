# 后端 Dockerfile - 使用 Debian 基础镜像避免编译问题
FROM node:20-slim

WORKDIR /app

# 安装必要的依赖
RUN apt-get update && apt-get install -y \
    python3 \
    make \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# 设置环境变量
ENV NODE_ENV=production

# 复制 package.json
COPY package*.json ./
RUN npm ci --only=production

# 复制本地构建产物
COPY dist ./dist

# 创建数据目录
RUN mkdir -p /data

# 暴露端口
EXPOSE 4000

# 启动命令
CMD ["node", "dist/main.js"]
